SELECT g.name AS genre, COUNT(ge.executor_id) AS artists_count
FROM genre g
LEFT JOIN genreexecutor ge ON g.id = ge.genre_id
GROUP BY g.name
ORDER BY artists_count DESC;

SELECT COUNT(t.id) AS tracks_count
FROM tracks t
JOIN albums a ON t.albums_id = a.id
WHERE a.year_of_release BETWEEN 2019 AND 2020;

SELECT a.name AS album, 
       AVG(EXTRACT(EPOCH FROM t.duration)/60) AS avg_duration_minutes
FROM albums a
JOIN tracks t ON a.id = t.albums_id
GROUP BY a.name
ORDER BY avg_duration_minutes DESC;

SELECT e.name AS artist
FROM executor e
WHERE e.id NOT IN (
    SELECT ea.executor_id
    FROM executoralbums ea
    JOIN albums a ON ea.albums_id = a.id
    WHERE a.year_of_release = 2020
);

SELECT DISTINCT c.name AS collection
FROM collection c
JOIN trackscollictions tc ON c.id = tc.collection_id
JOIN tracks t ON tc.tracks_id = t.id
JOIN albums a ON t.albums_id = a.id
JOIN executoralbums ea ON a.id = ea.albums_id
JOIN executor e ON ea.executor_id = e.id
WHERE e.name = 'Lana Del Rey';
